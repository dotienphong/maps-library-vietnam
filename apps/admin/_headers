# Header bảo mật cho hai SPA (/admin, /console) do [assets] của Worker phục vụ thẳng, không qua
# mã Worker — nên phải khai ở đây. Build admin chép file này vào gốc apps/admin/dist.
#
# CSP đang ở chế độ Report-Only (audit bảo mật 23/09/2026): trình duyệt chỉ báo cáo vi phạm tới
# /csp-report (đọc trong log Worker, tiền tố "[csp]") chứ chưa chặn. Khi log sạch vài ngày, đổi tên
# header thành Content-Security-Policy để bật chặn thật.
/admin/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://tiles.ai-solutions.io.vn https://challenges.cloudflare.com; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /csp-report
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=15552000
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

/console/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://tiles.ai-solutions.io.vn https://challenges.cloudflare.com; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /csp-report
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=15552000
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
