---
import { PERIOD_MONTHS } from '@mapslibvn/catalog';
import { CONSOLE_URL } from '../../site.config.mjs';
import { bangGia } from '../lib/gia';
import Nut from './Nut.astro';
import The from './The.astro';

const goi = bangGia();
---

<div>
  <fieldset class="mb-8 flex flex-wrap items-center gap-2">
    <legend class="t-small mb-2 font-semibold text-muted">Kỳ thanh toán</legend>
    {
      PERIOD_MONTHS.map((months) => (
        <label class="inline-flex min-h-11 cursor-pointer items-center rounded-[var(--radius-btn)] border border-border px-4 text-sm font-semibold transition-colors duration-150 has-[:checked]:border-accent-text has-[:checked]:bg-accent-soft has-[:checked]:text-accent-text">
          <input
            type="radio"
            name="ky"
            value={months}
            checked={months === 1}
            class="sr-only"
            data-ky
          />
          {months} tháng
        </label>
      ))
    }
    <p class="t-small w-full text-muted">
      Giá nhân đơn theo số tháng, không có chiết khấu và không tự động trừ tiền định kỳ.
    </p>
  </fieldset>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      goi.map((g) => (
        <The as="article" noiBat={g.noiBat} class="flex flex-col">
          {g.noiBat && (
            <p class="mb-3 inline-flex w-fit rounded-full bg-accent px-2.5 py-0.5 text-xs font-semibold text-accent-ink">
              Được chọn nhiều nhất
            </p>
          )}
          <h3 class="t-h3">{g.ten}</h3>
          <p class="mt-3">
            <span
              class="t-stat"
              data-gia1={g.theoKy[1].vndHienThi}
              data-gia3={g.theoKy[3].vndHienThi}
              data-gia6={g.theoKy[6].vndHienThi}
              data-gia12={g.theoKy[12].vndHienThi}
            >
              {g.theoKy[1].vndHienThi}
            </span>
            <span class="t-small text-muted" data-ky-nhan>
              / 1 tháng
            </span>
          </p>
          <p class="t-small mt-1 text-muted">
            tham chiếu{' '}
            <span
              data-usd1={g.theoKy[1].usdHienThi}
              data-usd3={g.theoKy[3].usdHienThi}
              data-usd6={g.theoKy[6].usdHienThi}
              data-usd12={g.theoKy[12].usdHienThi}
            >
              {g.theoKy[1].usdHienThi}
            </span>
          </p>

          <ul class="t-small mt-4 flex-1 space-y-2">
            <li>
              <strong>{g.placesHienThi}</strong> lượt Places
            </li>
            <li>
              <strong>{g.directionsHienThi}</strong> lượt tính tuyến
            </li>
            {g.tranNgay && <li>Trần ngày: {g.tranNgay}</li>}
            <li>{g.ghiChuHan}</li>
            <li>{g.hoTroOnline ? 'Có hỗ trợ trực tuyến' : 'Hỗ trợ qua tài liệu'}</li>
          </ul>

          <Nut href={CONSOLE_URL} kieu={g.noiBat ? 'chinh' : 'phu'} class="mt-5">
            {g.tier === 'trial' ? 'Dùng thử miễn phí' : `Chọn ${g.ten}`}
          </Nut>
        </The>
      ))
    }
  </div>
</div>

<script>
  // Giá của cả bốn kỳ đã nằm sẵn trong data-*, nên script chỉ đổi chữ. JavaScript hỏng hay bị
  // chặn thì trang vẫn hiện đúng giá một tháng — số tiền không bao giờ phụ thuộc trình duyệt.
  //
  // Tên thuộc tính KHÔNG có gạch trước chữ số (`data-gia3`, không phải `data-gia-3`): thuật toán
  // đổi tên của dataset chỉ bỏ dấu gạch khi sau nó là CHỮ THƯỜNG, nên `data-gia-3` đọc ra
  // `dataset['gia-3']` chứ không phải `dataset.gia3`. Bản đầu viết sai và giá không bao giờ đổi.
  const dat = (ky: string) => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-gia1]')) {
      const gia = el.dataset[`gia${ky}`];
      if (gia) el.textContent = gia;
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-usd1]')) {
      const usd = el.dataset[`usd${ky}`];
      if (usd) el.textContent = usd;
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-ky-nhan]')) {
      el.textContent = `/ ${ky} tháng`;
    }
  };
  for (const radio of document.querySelectorAll<HTMLInputElement>('[data-ky]')) {
    radio.addEventListener('change', () => dat(radio.value));
  }
</script>
