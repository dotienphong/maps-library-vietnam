---
import {
  CONSOLE_URL,
  DOCS_URL,
  SUPPORT_EMAIL,
  SUPPORT_PHONE,
  SUPPORT_PHONE_HIEN_THI,
} from '../../site.config.mjs';
import { TRANG } from '../lib/trang';
import Nhan from './Nhan.astro';
import Nut from './Nut.astro';

const COT = [
  {
    ten: 'Sản phẩm',
    muc: [
      { nhan: 'Tính năng', href: TRANG.tinhNang.path },
      { nhan: 'Bảng giá', href: TRANG.bangGia.path },
      { nhan: 'Thử trực tiếp', href: `${DOCS_URL}/playground` },
      { nhan: 'Tài liệu kỹ thuật', href: `${DOCS_URL}/bat-dau/` },
    ],
  },
  {
    ten: 'So sánh',
    muc: [
      { nhan: 'So với Google Maps', href: TRANG.soSanhGoogle.path },
      { nhan: 'So với VIETMAP', href: TRANG.soSanhVietmap.path },
      { nhan: 'Bài viết', href: TRANG.baiViet.path },
    ],
  },
  /**
   * Ghi nguồn ODbL và Apache-2.0 KHÔNG nằm ở chân trang nữa (PHONG chốt 22/09/2026). Nghĩa vụ vẫn
   * được giữ ở đúng chỗ dữ liệu xuất hiện: cả hai ảnh bản đồ (`ban-do-hero*.jpg`) đều có chuỗi
   * "© MapsLibVN · © OpenStreetMap contributors (ODbL) · © OpenMapTiles · Foursquare OS Places
   * (Apache-2.0)" vẽ sẵn ở góc dưới phải, và iframe playground mang điều khiển ghi nguồn của
   * MapLibre. Trang nào không hiện bản đồ thì cũng không hiển thị dữ liệu OSM.
   *
   * Link "Giấy phép và ghi nguồn" dưới đây là đường tới bản đầy đủ và PHẢI có ở mọi trang —
   * `e2e/trang.spec.ts` khoá lại. Đừng bỏ nó đi cùng lúc với chân trang.
   */
  {
    ten: 'Pháp lý',
    muc: [
      { nhan: 'Giấy phép và ghi nguồn', href: `${DOCS_URL}/giay-phep/` },
      { nhan: 'Điều khoản tenant', href: `${DOCS_URL}/dieu-khoan/` },
      { nhan: 'Thông báo bên thứ ba', href: `${DOCS_URL}/thong-bao-ben-thu-ba/` },
    ],
  },
] as const;
---

<footer class="mt-24 border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        COT.map((cot) => (
          <nav aria-label={cot.ten}>
            <h2 class="mb-4"><Nhan chu={cot.ten} /></h2>
            <ul class="space-y-2">
              {cot.muc.map((muc) => (
                <li>
                  <a
                    href={muc.href}
                    class="inline-flex min-h-11 items-center text-[15px] text-muted transition-colors duration-150 hover:text-text"
                  >
                    {muc.nhan}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div>
        <h2 class="mb-4"><Nhan chu="Liên hệ" /></h2>
        <p class="t-small text-muted">
          <a
            href={`mailto:${SUPPORT_EMAIL}`}
            class="inline-flex min-h-11 items-center hover:text-accent-text"
          >
            {SUPPORT_EMAIL}
          </a>
        </p>
        <p class="t-small text-muted">
          {/* href dùng dạng E.164 không khoảng trắng để máy gọi đúng số; phần hiển thị tách nhóm
              cho người đọc. Trên điện thoại, chạm vào là gọi ngay. */}
          <a
            href={`tel:${SUPPORT_PHONE}`}
            class="inline-flex min-h-11 items-center hover:text-accent-text"
          >
            {SUPPORT_PHONE_HIEN_THI}
          </a>
        </p>
        <p class="t-small text-muted">
          Hỗ trợ trực tuyến cho gói Professional và Business: thứ Hai đến thứ Sáu 08:00–20:00, thứ
          Bảy và Chủ nhật 08:00–17:00, giờ Việt Nam.
        </p>
        <Nut href={CONSOLE_URL} kieu="phu" co="nho" class="mt-3">Cổng khách hàng</Nut>
      </div>
    </div>

  </div>
</footer>
