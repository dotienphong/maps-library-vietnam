---
import { DOCS_URL } from '../../site.config.mjs';

/**
 * Bốn cách nhúng, khớp từng dòng với trang Cài đặt của tài liệu. Tab chạy bằng script vanilla theo
 * đúng khuôn ARIA tablist, không React. Khi JavaScript tắt, tab ĐẦU vẫn hiện vì chỉ panel sau mới
 * mang thuộc tính hidden.
 *
 * Bản ESM và React KHÔNG gộp maplibre-gl: đoạn mã phải cài peer và (với ESM) truyền `maplibre` vào,
 * nếu không `createMap` ném lỗi ngay. Bản đầu của trang chép thiếu hai dòng đó và chạy là vỡ.
 */
const TABS = [
  {
    id: 'script',
    nhan: 'Thẻ script',
    ma: `<link rel="stylesheet" href="${DOCS_URL}/sdk/mapslibvn.css" />
<script src="${DOCS_URL}/sdk/mapslibvn.umd.js"></script>
<div id="map" style="height:400px"></div>
<script>
  const map = MapsLibVN.createMap({
    container: 'map',
    apiKey: 'mlv_live_…',
    apiBase: 'https://api.ai-solutions.io.vn',
    center: [106.7, 10.776],
    zoom: 13,
  });
</script>`,
    ghiChu: 'Không cần build hay npm. Bản UMD đã gộp sẵn maplibre-gl và pmtiles.',
  },
  {
    id: 'npm',
    nhan: 'npm',
    ma: `npm install @mapslibvn/web maplibre-gl

import 'maplibre-gl/dist/maplibre-gl.css';
import * as maplibregl from 'maplibre-gl';
import { createMap } from '@mapslibvn/web';

const map = createMap(
  {
    container: 'map',
    apiKey: 'mlv_live_…',
    apiBase: 'https://api.ai-solutions.io.vn',
    center: [106.7, 10.776],
    zoom: 13,
  },
  { maplibre: maplibregl },
);`,
    ghiChu:
      'maplibre-gl là peer dependency, bạn tự cài và truyền vào. Khi build còn phải trỏ worker của MapLibre về thư mục tĩnh của bạn.',
  },
  {
    id: 'react',
    nhan: 'React',
    ma: `npm install @mapslibvn/react maplibre-gl

import 'maplibre-gl/dist/maplibre-gl.css';
import { MapsLibVNMap, Marker } from '@mapslibvn/react';

export default function BanDo() {
  return (
    <MapsLibVNMap
      apiKey="mlv_live_…"
      apiBase="https://api.ai-solutions.io.vn"
      center={[106.7, 10.776]}
      zoom={13}
      containerStyle={{ height: 400 }}
    >
      <Marker lng={106.6981} lat={10.7725} popupHtml="<b>Chợ Bến Thành</b>" />
    </MapsLibVNMap>
  );
}`,
    ghiChu:
      'Gói tự import maplibre-gl nên không cần truyền deps, nhưng vẫn cần bước worker của MapLibre khi build.',
  },
  {
    id: 'rn',
    nhan: 'React Native',
    ma: `npx expo install @maplibre/maplibre-react-native expo-application
npm install @mapslibvn/react-native

import { MapsLibVNMap } from '@mapslibvn/react-native';

export default function ManBanDo() {
  return (
    <MapsLibVNMap
      apiKey="mlv_live_…"
      apiBase="https://api.ai-solutions.io.vn"
      center={[106.7, 10.776]}
      zoom={13}
    />
  );
}`,
    ghiChu:
      'Dùng khoá loại mobile. Cần New Architecture và không chạy trên Expo Go, phải build native.',
  },
] as const;

/**
 * Thoát HTML rồi tô `--accent-text` cho tên hàm/component chính. Không tô cú pháp đầy đủ để khỏi
 * kéo thêm CSS/JS (spec 5.5). Thoát TRƯỚC khi chèn thẻ, nếu không `<MapsLibVNMap>` trong mẫu mã
 * React sẽ được trình duyệt đọc thành thẻ thật.
 */
const thoat = (chu: string) =>
  chu.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
const toSang = (ma: string) =>
  thoat(ma).replace(
    /\b(createMap|MapsLibVNMap)\b/g,
    '<b class="font-normal text-accent-text">$1</b>',
  );
---

<div>
  <div
    role="tablist"
    aria-label="Bốn cách nhúng bản đồ"
    class="flex flex-wrap gap-1 border-b border-border"
  >
    {
      TABS.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="-mb-px inline-flex min-h-11 items-center border-b-2 border-transparent px-4 text-[15px] font-semibold text-muted transition-colors duration-150 hover:text-text aria-selected:border-accent-text aria-selected:text-text"
        >
          {tab.nhan}
        </button>
      ))
    }
  </div>

  {
    TABS.map((tab, i) => (
      <div
        role="tabpanel"
        id={`panel-${tab.id}`}
        aria-labelledby={`tab-${tab.id}`}
        hidden={i !== 0}
        tabindex="0"
        class="mt-4 overflow-x-auto rounded-[10px] border border-border bg-surface-2 p-4 sm:p-5"
      >
        <pre class="t-code text-text"><code set:html={toSang(tab.ma)} /></pre>
        <p class="t-small mt-3 text-muted">{tab.ghiChu}</p>
      </div>
    ))
  }

  <p class="t-small mt-4 text-muted">
    Yêu cầu từng môi trường, bước worker của MapLibre cho bundler và bảng lỗi hay gặp nằm ở
    <a class="text-accent-text underline" href={`${DOCS_URL}/cai-dat/`}>trang Cài đặt</a>.
  </p>
</div>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const chon = (muc: HTMLButtonElement) => {
    for (const tab of tabs) {
      const dung = tab === muc;
      tab.setAttribute('aria-selected', String(dung));
      tab.tabIndex = dung ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !dung;
    }
    muc.focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => chon(tab));
    tab.addEventListener('keydown', (su) => {
      // Mũi tên trái/phải là điều bàn phím mong đợi ở một tablist; thiếu nó thì người dùng
      // bàn phím phải Tab qua từng tab rồi mới tới nội dung.
      const buoc = su.key === 'ArrowRight' ? 1 : su.key === 'ArrowLeft' ? -1 : 0;
      if (buoc === 0) return;
      su.preventDefault();
      chon(tabs[(i + buoc + tabs.length) % tabs.length] as HTMLButtonElement);
    });
  });
</script>
