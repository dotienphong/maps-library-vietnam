---
import { DOCS_URL } from '../../site.config.mjs';

/**
 * Ba cách nhúng. Tab chạy bằng script vanilla theo đúng khuôn ARIA tablist, không React.
 * Khi JavaScript tắt, tab ĐẦU vẫn hiện vì chỉ panel sau mới mang thuộc tính hidden.
 */
const TABS = [
  {
    id: 'script',
    nhan: 'Thẻ script',
    ma: `<link rel="stylesheet" href="${DOCS_URL}/sdk/mapslibvn.css" />
<script src="${DOCS_URL}/sdk/mapslibvn.umd.js"></script>
<div id="map" style="height:400px"></div>
<script>
  const map = MapsLibVN.createMap({
    container: 'map',
    apiKey: 'mlv_live_…',
    apiBase: 'https://api.ai-solutions.io.vn',
    center: [106.7, 10.776],
    zoom: 13,
  });
</script>`,
  },
  {
    id: 'npm',
    nhan: 'npm',
    ma: `npm install @mapslibvn/web

import { createMap } from '@mapslibvn/web';
import '@mapslibvn/web/style.css';

const map = createMap({
  container: 'map',
  apiKey: 'mlv_live_…',
  apiBase: 'https://api.ai-solutions.io.vn',
  center: [106.7, 10.776],
  zoom: 13,
});`,
  },
  {
    id: 'rn',
    nhan: 'React Native',
    ma: `npm install @mapslibvn/react-native

import { MapsLibVNMap } from '@mapslibvn/react-native';

export default function ManBanDo() {
  return (
    <MapsLibVNMap
      apiKey="mlv_live_…"
      apiBase="https://api.ai-solutions.io.vn"
      center={[106.7, 10.776]}
      zoom={13}
    />
  );
}`,
  },
] as const;
---

<div class="mx-auto max-w-4xl px-4">
  <div role="tablist" aria-label="Ba cách nhúng bản đồ" class="flex flex-wrap gap-1">
    {
      TABS.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="inline-flex min-h-11 items-center rounded-[var(--radius-btn)] px-4 text-sm font-semibold text-[var(--text-muted)] aria-selected:bg-brand-50 aria-selected:text-brand-700 dark:aria-selected:bg-brand-900 dark:aria-selected:text-brand-100"
        >
          {tab.nhan}
        </button>
      ))
    }
  </div>

  {
    TABS.map((tab, i) => (
      <div
        role="tabpanel"
        id={`panel-${tab.id}`}
        aria-labelledby={`tab-${tab.id}`}
        hidden={i !== 0}
        tabindex="0"
        class="mt-3 overflow-x-auto rounded-[var(--radius-card)] border border-[var(--border)] bg-[var(--surface)] p-4"
      >
        <pre class="text-sm"><code>{tab.ma}</code></pre>
      </div>
    ))
  }
</div>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const chon = (muc: HTMLButtonElement) => {
    for (const tab of tabs) {
      const dung = tab === muc;
      tab.setAttribute('aria-selected', String(dung));
      tab.tabIndex = dung ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !dung;
    }
    muc.focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => chon(tab));
    tab.addEventListener('keydown', (su) => {
      // Mũi tên trái/phải là điều bàn phím mong đợi ở một tablist; thiếu nó thì người dùng
      // bàn phím phải Tab qua từng tab rồi mới tới nội dung.
      const buoc = su.key === 'ArrowRight' ? 1 : su.key === 'ArrowLeft' ? -1 : 0;
      if (buoc === 0) return;
      su.preventDefault();
      chon(tabs[(i + buoc + tabs.length) % tabs.length] as HTMLButtonElement);
    });
  });
</script>
