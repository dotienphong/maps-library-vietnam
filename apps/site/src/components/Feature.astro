---
interface Props {
  tieuDe: string;
  mo: string;
  href: string;
  nhanLink: string;
  /** Một ký tự hoặc emoji làm dấu nhận biết; thuần trang trí nên aria-hidden. */
  dau: string;
}

const { tieuDe, mo, href, nhanLink, dau } = Astro.props;
---

<article class="rounded-[var(--radius-card)] border border-[var(--border)] bg-[var(--surface)] p-5">
  <p aria-hidden="true" class="mb-3 flex h-10 w-10 items-center justify-center rounded-[var(--radius-btn)] bg-accent-soft text-xl">
    {dau}
  </p>
  <h3 class="text-base font-bold">{tieuDe}</h3>
  <p class="mt-2 text-sm text-[var(--text-muted)]">{mo}</p>
  <a
    href={href}
    class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-accent-text hover:underline"
  >
    {nhanLink} →
  </a>
</article>
