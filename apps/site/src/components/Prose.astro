---
/**
 * Bọc nội dung Markdown của bài viết. Tailwind v4 ở repo này không có plugin typography, nên kiểu
 * chữ khai thẳng bằng bộ chọn con — ít phụ thuộc hơn và đủ cho một trang bài viết.
 */
---

<div class="prose-bai">
  <slot />
</div>

<style>
  /* Cùng thang với `t-h2` của site (spec 4.2) — bài viết không được có thang chữ riêng.
     `scroll-margin` để mục lục bài nhảy tới không bị header dính che mất tiêu đề. */
  .prose-bai :global(h2) {
    margin-top: 3rem;
    margin-bottom: 0.75rem;
    font-size: clamp(24px, 1vw + 18px, 28px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    scroll-margin-top: 6rem;
    color: var(--text);
  }

  .prose-bai :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-size: clamp(18px, 0.5vw + 15px, 20px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
    scroll-margin-top: 6rem;
    color: var(--text);
  }

  .prose-bai :global(p),
  .prose-bai :global(ul),
  .prose-bai :global(ol) {
    margin-bottom: 1.125rem;
    font-size: clamp(16px, 0.25vw + 14.5px, 17px);
    line-height: 1.75;
    color: var(--text-muted);
  }

  .prose-bai :global(ul),
  .prose-bai :global(ol) {
    padding-left: 1.5rem;
    list-style: revert;
  }

  .prose-bai :global(li) {
    margin-bottom: 0.375rem;
  }

  .prose-bai :global(a) {
    color: var(--accent-text);
    text-decoration: underline;
  }

  .prose-bai :global(strong) {
    color: var(--text);
  }

  .prose-bai :global(table) {
    width: 100%;
    margin-bottom: 1.5rem;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .prose-bai :global(th),
  .prose-bai :global(td) {
    border-top: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .prose-bai :global(blockquote) {
    margin-bottom: 1rem;
    border-left: 3px solid var(--border);
    padding-left: 1rem;
    color: var(--text-muted);
  }
</style>
