---
/**
 * Bọc nội dung Markdown của bài viết. Tailwind v4 ở repo này không có plugin typography, nên kiểu
 * chữ khai thẳng bằng bộ chọn con — ít phụ thuộc hơn và đủ cho một trang bài viết.
 */
---

<div class="prose-bai">
  <slot />
</div>

<style>
  .prose-bai :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .prose-bai :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .prose-bai :global(p),
  .prose-bai :global(ul),
  .prose-bai :global(ol) {
    margin-bottom: 1rem;
    color: var(--text-muted);
  }

  .prose-bai :global(ul),
  .prose-bai :global(ol) {
    padding-left: 1.5rem;
    list-style: revert;
  }

  .prose-bai :global(li) {
    margin-bottom: 0.375rem;
  }

  .prose-bai :global(a) {
    text-decoration: underline;
  }

  .prose-bai :global(strong) {
    color: var(--text);
  }

  .prose-bai :global(table) {
    width: 100%;
    margin-bottom: 1.5rem;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .prose-bai :global(th),
  .prose-bai :global(td) {
    border-top: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .prose-bai :global(blockquote) {
    margin-bottom: 1rem;
    border-left: 3px solid var(--border);
    padding-left: 1rem;
    color: var(--text-muted);
  }
</style>
