---
/**
 * Câu hỏi thường gặp, không một dòng JavaScript: <details> đóng mở sẵn trong trình duyệt.
 * Trang gọi component này PHẢI truyền cùng mảng đó vào faqJsonLd() — Google phạt khi đánh dấu
 * FAQPage nói một đằng còn chữ trên trang nói một nẻo.
 */
interface Props {
  items: readonly { hoi: string; dap: string }[];
  tieuDe?: string | undefined;
}

const { items, tieuDe = 'Câu hỏi thường gặp' } = Astro.props;
const id = 'faq-tieu-de';
---

<section aria-labelledby={id} class="mx-auto max-w-3xl px-4 py-16">
  <h2 id={id} class="mb-6 text-2xl font-bold">{tieuDe}</h2>
  <div class="divide-y divide-[var(--border)] rounded-[var(--radius-card)] border border-[var(--border)] bg-[var(--surface)]">
    {
      items.map((item) => (
        <details class="group">
          <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-4 p-4 font-semibold">
            {item.hoi}
            <span aria-hidden="true" class="text-[var(--text-muted)] group-open:rotate-180">
              ⌄
            </span>
          </summary>
          <p class="px-4 pb-4 text-[var(--text-muted)]">{item.dap}</p>
        </details>
      ))
    }
  </div>
</section>
