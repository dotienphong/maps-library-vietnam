---
import { Picture } from 'astro:assets';
import { CONSOLE_URL, DOCS_URL } from '../../site.config.mjs';
import banDo from '../assets/ban-do-hero.jpg';
import MucLucDinh from '../components/MucLucDinh.astro';
import Nhan from '../components/Nhan.astro';
import Nut from '../components/Nut.astro';
import OGoiY from '../components/OGoiY.astro';
import The from '../components/The.astro';
import Base from '../layouts/Base.astro';
import { CHUA_CO } from '../lib/doi-dau';
import { breadcrumbJsonLd } from '../lib/seo';
import { TRANG } from '../lib/trang';

const NHOM_POI = [
  ['Ăn uống', 14],
  ['Mua sắm', 24],
  ['Dịch vụ', 21],
  ['Y tế', 11],
  ['Giáo dục', 13],
  ['Tài chính', 6],
  ['Lưu trú', 8],
  ['Giải trí, thể thao', 16],
  ['Văn hoá, du lịch', 15],
  ['Giao thông', 13],
  ['Hành chính công', 13],
  ['Tôn giáo, cộng đồng', 9],
  ['Khác', 1],
] as const;

const SDK = ['@mapslibvn/core', '@mapslibvn/web', '@mapslibvn/react', '@mapslibvn/react-native'];

const CHANG = ['Đi theo Nguyễn Huệ về hướng bắc 400 m', 'Rẽ phải vào Lê Lợi', 'Đến nơi ở bên trái'];

/** Số phút minh hoạ cho bảng 3×3 ở mục Giao hàng — ô ≤ 6 phút tô màu nhấn là "tài xế gần nhất". */
const MA_TRAN_MINH_HOA: readonly { ten: string; phut: readonly number[] }[] = [
  { ten: 'Tài xế A', phut: [6, 14, 21] },
  { ten: 'Tài xế B', phut: [11, 5, 17] },
  { ten: 'Tài xế C', phut: [19, 12, 4] },
];

const MUC = [
  {
    id: 'ban-do',
    nhan: 'Bản đồ nền',
    tieuDe: 'Bản đồ nền Việt Nam',
    doan: [
      'Tiles ở định dạng PMTiles đặt trên CDN. Trình duyệt đọc thẳng bằng HTTP Range chứ không đi qua máy chủ API, nên tải bản đồ không tốn lượt gọi API và không phụ thuộc vào một cụm máy chủ tile nào.',
      'Hai theme sáng và tối, nhãn hiển thị tiếng Việt hoặc tiếng Anh tuỳ cấu hình. Nhãn chủ quyền Hoàng Sa và Trường Sa luôn giữ tiếng Việt, được bảo vệ ở ba tầng: vá dữ liệu trước khi dựng tiles, lớp nhãn riêng trong style, và một bước kiểm tự động chặn phát hành nếu thiếu.',
    ],
    href: `${DOCS_URL}/ban-do-web/`,
    nhanLink: 'Hướng dẫn bản đồ web',
  },
  {
    id: 'poi',
    nhan: 'Địa điểm',
    tieuDe: 'Lớp địa điểm 164 loại',
    doan: [
      'Địa điểm gộp từ OpenStreetMap và Foursquare OS Places. Mỗi địa điểm có một nguồn chính quyết định toạ độ và tên; các nguồn khác được ghi lại để bạn đối chiếu.',
      'Biểu tượng xuất hiện tăng dần theo mức phóng để bản đồ không rối. Địa điểm chưa hiện trên nền vẫn tìm được qua API tìm kiếm.',
    ],
    href: `${DOCS_URL}/tinh-nang/`,
    nhanLink: 'Danh mục đầy đủ',
  },
  {
    id: 'tim-kiem',
    nhan: 'Tìm kiếm',
    tieuDe: 'Tìm kiếm hiểu cách người Việt gõ',
    doan: [
      'Gợi ý hiện ngay khi đang gõ. Bộ tìm kiếm chịu được chữ không dấu, viết tắt quen thuộc và cách viết địa phương.',
      'Tên đơn vị hành chính cũ và mới đều tra được, kể cả sau đợt sắp xếp năm 2025, nên người dùng gõ theo thói quen vẫn ra đúng chỗ.',
    ],
    href: `${DOCS_URL}/tim-kiem/`,
    nhanLink: 'Tìm kiếm và autocomplete',
  },
  {
    id: 'geocode',
    nhan: 'Geocode',
    tieuDe: 'Geocode nói thật về độ chính xác',
    doan: [
      'Mỗi kết quả trả kèm precision và confidence, nói rõ toạ độ đang ở mức mái nhà, đoạn hẻm hay chỉ tới được phường. Ứng dụng nhờ đó vẽ vòng tròn sai số thay vì cắm một cái ghim giả vờ chính xác.',
      'Địa chỉ không tra được thì hệ thống nói không tra được, thay vì rơi về tâm quận rồi để người dùng tưởng đã đúng.',
    ],
    href: `${DOCS_URL}/do-chinh-xac/`,
    nhanLink: 'Độ chính xác geocode',
  },
  {
    id: 'dan-duong',
    nhan: 'Dẫn đường',
    tieuDe: 'Dẫn đường',
    doan: [
      'Tính tuyến cho xe máy, ô tô và đi bộ, trả về hình tuyến cùng hướng dẫn từng chặng bằng tiếng Việt tự nhiên.',
      'Dùng được cả trên web lẫn React Native, kèm la bàn và cảm biến chuyển động cho màn hình dẫn đường trên điện thoại.',
    ],
    href: `${DOCS_URL}/dan-duong/`,
    nhanLink: 'Hướng dẫn dẫn đường',
  },
  {
    id: 'giao-hang',
    nhan: 'Giao hàng',
    tieuDe: 'Giao hàng & vận tải',
    doan: [
      'Ma trận khoảng cách trả bảng thời gian và quãng đường từ N điểm đi tới M điểm đến trong một lượt gọi — chọn tài xế gần nhất, kho gần nhất mà không phải tính từng tuyến. Tối đa 50 cặp mỗi lượt.',
      'Tối ưu thứ tự điểm dừng sắp lại tối đa 8 điểm giao cho một chuyến và trả luôn tuyến đầy đủ để vẽ và dẫn đường. Cả hai tính một lượt Chỉ đường, và thử được ngay trên Playground, tab Đội xe. Chưa có tối ưu đội xe nhiều xe.',
    ],
    href: `${DOCS_URL}/doi-xe/`,
    nhanLink: 'Hướng dẫn giao hàng & đội xe',
  },
  {
    id: 'sdk',
    nhan: 'SDK',
    tieuDe: 'Bốn SDK dùng chung một hợp đồng',
    doan: [
      'core, web, react và react-native phát hành trên npm, cùng một API và cùng một nguồn tiles. Đổi nền tảng không phải học lại.',
      'Có thể nhúng bằng thẻ script cho trang tĩnh, hoặc cài qua npm cho dự án có bước dựng.',
    ],
    href: `${DOCS_URL}/cai-dat/`,
    nhanLink: 'Cài đặt',
  },
] as const;
---

<Base
  trang={TRANG.tinhNang}
  jsonLd={[
    breadcrumbJsonLd([
      { ten: 'Trang chủ', path: TRANG.trangChu.path },
      { ten: 'Tính năng', path: TRANG.tinhNang.path },
    ]),
  ]}
>
  <section class="mx-auto max-w-[1200px] px-4 pt-14 sm:px-6">
    <p class="mb-3"><Nhan chu="Tính năng" noiBat /></p>
    <h1 class="t-h1 max-w-3xl">{TRANG.tinhNang.h1}</h1>
    <p class="t-lead mt-5 max-w-2xl text-muted">
      Những gì liệt kê dưới đây đang chạy thật trên hệ thống, không phải kế hoạch. Cuối trang có mục
      nói rõ những thứ MapsLibVN chưa làm.
    </p>
  </section>

  <div class="mx-auto mt-12 grid max-w-[1200px] gap-10 px-4 sm:px-6 lg:grid-cols-[200px_1fr]">
    <MucLucDinh
      nhanNav="Mục lục tính năng"
      muc={MUC.map((m) => ({ id: m.id, nhan: m.nhan }))}
      class="hidden h-fit lg:block"
    />

    <div class="space-y-16 lg:space-y-24">
      {
        MUC.map((muc, i) => (
          <section id={muc.id} aria-labelledby={`tt-${muc.id}`} class="scroll-mt-24">
            <div class="grid items-center gap-6 lg:grid-cols-2 lg:gap-10">
              <div class:list={[i % 2 === 1 && 'lg:order-2']}>
                <h2 id={`tt-${muc.id}`} class="t-h2">
                  {muc.tieuDe}
                </h2>
                {muc.doan.map((d) => (
                  <p class="t-body mt-4 text-muted">{d}</p>
                ))}
                <a
                  href={muc.href}
                  class="mt-5 inline-flex min-h-11 items-center font-semibold text-accent-text hover:underline"
                >
                  {muc.nhanLink} →
                </a>
              </div>

              <div data-bang-chung>
                {muc.id === 'ban-do' && (
                  /* Bản đồ LUÔN dùng theme sáng, kể cả khi trang đang tối (PHONG chốt 22/09/2026):
                     đây là ảnh sản phẩm chứ không phải một mảng giao diện, nên nó giữ một diện mạo
                     duy nhất. Giống khối bản đồ ở trang chủ. */
                  <Picture
                    src={banDo}
                    alt="Bản đồ trung tâm Thành phố Hồ Chí Minh do MapsLibVN dựng"
                    widths={[480, 720, 960]}
                    sizes="(max-width: 1024px) 100vw, 520px"
                    formats={['avif', 'webp']}
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-[var(--radius-card)] border border-border"
                  />
                )}

                {muc.id === 'poi' && (
                  <div class="max-h-80 overflow-y-auto rounded-[var(--radius-card)] border border-border">
                    <table class="w-full border-collapse text-left">
                      <caption class="t-small bg-surface-2 px-4 py-3 font-semibold">
                        13 nhóm và số mã loại trong mỗi nhóm
                      </caption>
                      <tbody>
                        {NHOM_POI.map(([ten, so]) => (
                          <tr class="border-t border-border">
                            <th scope="row" class="t-small px-4 py-2 font-normal text-muted">
                              {ten}
                            </th>
                            <td class="t-small px-4 py-2 text-right font-semibold">{so}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                {muc.id === 'tim-kiem' && <OGoiY />}

                {muc.id === 'geocode' && (
                  <pre class="t-code overflow-x-auto rounded-[var(--radius-card)] border border-border bg-surface-2 p-4 text-muted"><code>{`{
  "name": "Nhà thờ Đức Bà",
  "precision": "rooftop",
  "confidence": 0.94,
  "lat": 10.7797, "lng": 106.699
}`}</code></pre>
                )}

                {muc.id === 'dan-duong' && (
                  <The nen="surface-2">
                    <ul class="flex gap-2">
                      {['Xe máy', 'Ô tô', 'Đi bộ'].map((c) => (
                        <li class="t-small rounded-full border border-border px-3 py-1">{c}</li>
                      ))}
                    </ul>
                    <svg viewBox="0 0 320 70" class="mt-4 h-16 w-full" aria-hidden="true">
                      <path
                        d="M8 60 C 80 14, 150 76, 210 36 S 290 10, 312 18"
                        fill="none"
                        stroke="var(--border-strong)"
                        stroke-width="7"
                        stroke-linecap="round"
                      />
                      <path
                        d="M8 60 C 80 14, 150 76, 210 36"
                        fill="none"
                        stroke="var(--accent-text)"
                        stroke-width="7"
                        stroke-linecap="round"
                      />
                      <circle cx="8" cy="60" r="6" fill="var(--accent-text)" />
                      <circle cx="312" cy="18" r="6" fill="var(--text)" />
                    </svg>
                    <ol class="t-small mt-4 space-y-1 text-muted">
                      {CHANG.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ol>
                  </The>
                )}

                {muc.id === 'giao-hang' && (
                  <The nen="surface-2">
                    <table class="w-full border-collapse text-left">
                      <caption class="t-small pb-2 text-muted">
                        Phút xe máy từ 3 tài xế tới 3 đơn
                      </caption>
                      <thead>
                        <tr class="t-small text-muted">
                          <th scope="col" class="py-1 pr-3 font-normal" />
                          <th scope="col" class="py-1 pr-3 font-normal">Đơn 1</th>
                          <th scope="col" class="py-1 pr-3 font-normal">Đơn 2</th>
                          <th scope="col" class="py-1 font-normal">Đơn 3</th>
                        </tr>
                      </thead>
                      <tbody class="t-small">
                        {
                          MA_TRAN_MINH_HOA.map(({ ten, phut }) => (
                            <tr class="border-t border-border">
                              <th scope="row" class="py-1 pr-3 font-normal text-muted">
                                {ten}
                              </th>
                              {phut.map((p) => (
                                <td
                                  class:list={[
                                    'py-1 pr-3 font-semibold',
                                    p <= 6 && 'text-accent-text',
                                  ]}
                                >
                                  {p}
                                </td>
                              ))}
                            </tr>
                          ))
                        }
                      </tbody>
                    </table>
                    <p class="t-small mt-4 text-muted">Thứ tự ghé tối ưu cho một chuyến 3 điểm:</p>
                    <ol class="t-code mt-1 flex flex-wrap items-center gap-2 text-text">
                      {
                        ['Kho', '2', '3', '1', 'Kho'].map((b, i) => (
                          <li class="flex items-center gap-2">
                            {i > 0 && (
                              <span aria-hidden="true" class="text-muted">
                                →
                              </span>
                            )}
                            <span class="rounded-full border border-border px-3 py-1">{b}</span>
                          </li>
                        ))
                      }
                    </ol>
                  </The>
                )}

                {muc.id === 'sdk' && (
                  <The nen="surface-2">
                    <ul class="t-code space-y-2 text-muted">
                      {SDK.map((goi) => (
                        <li>{goi}</li>
                      ))}
                    </ul>
                  </The>
                )}
              </div>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <section aria-labelledby="tt-chua-co" class="mt-20 border-t border-border bg-surface py-16">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
      <p class="mb-3"><Nhan chu="Nói trước" noiBat /></p>
      <h2 id="tt-chua-co" class="t-h2">Những thứ chưa có</h2>
      <p class="t-body mt-4 max-w-2xl text-muted">
        Nói trước để bạn khỏi mất thời gian thử. Nếu hệ thống của bạn cần một trong số này, hãy đọc
        <a class="text-accent-text underline" href={TRANG.soSanhGoogle.path}>bản so sánh với Google</a
        > trước khi quyết định.
      </p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          CHUA_CO.map((c) => (
            <li class="t-small rounded-full border border-border px-4 py-2 text-faint line-through">
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 py-16 text-center sm:px-6">
    <Nut href={CONSOLE_URL} co="lon">Lấy khoá API miễn phí</Nut>
  </section>
</Base>
