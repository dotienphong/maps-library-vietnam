---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ngayVn, sapTheoNgayMoi } from '../../lib/bai-viet';
import { breadcrumbJsonLd } from '../../lib/seo';
import { TRANG } from '../../lib/trang';

// Chỉ bài đã được duyệt mới hiện. Bài đang soạn nằm trong repo nhưng không lên web và không
// lên sitemap, nên không có chuyện một bản nháp bị Google lập chỉ mục.
const bai = sapTheoNgayMoi(
  (await getCollection('baiViet', ({ data }) => data.daDuyet)).map((item) => ({
    slug: item.id,
    ...item.data,
  })),
);
---

<Base
  trang={TRANG.baiViet}
  jsonLd={[
    breadcrumbJsonLd([
      { ten: 'Trang chủ', path: TRANG.trangChu.path },
      { ten: 'Bài viết', path: TRANG.baiViet.path },
    ]),
  ]}
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold sm:text-4xl">{TRANG.baiViet.h1}</h1>
    <p class="mt-4 text-lg text-[var(--text-muted)]">
      Ghi chép kỹ thuật về chi phí API bản đồ, dữ liệu mở và chất lượng geocode tại Việt Nam.
    </p>

    {
      bai.length === 0 ? (
        <p class="mt-10 rounded-[var(--radius-card)] border border-dashed border-[var(--border)] p-8 text-center text-[var(--text-muted)]">
          Chưa có bài nào được đăng. Bài đầu tiên đang trong quá trình biên tập.
        </p>
      ) : (
        <ul class="mt-10 space-y-4">
          {bai.map((b) => (
            <li class="rounded-[var(--radius-card)] border border-[var(--border)] bg-[var(--surface)] p-5">
              <p class="text-sm text-[var(--text-muted)]">
                <time datetime={b.publishedAt}>{ngayVn(b.publishedAt)}</time>
              </p>
              <h2 class="mt-1 text-xl font-bold">
                <a href={`/bai-viet/${b.slug}/`} class="hover:underline">
                  {b.title}
                </a>
              </h2>
              <p class="mt-2 text-[var(--text-muted)]">{b.description}</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {b.tags.map((tag) => (
                  <li class="rounded-full bg-black/5 px-2.5 py-0.5 text-xs font-semibold text-[var(--text-muted)] dark:bg-white/10">
                    {tag}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
