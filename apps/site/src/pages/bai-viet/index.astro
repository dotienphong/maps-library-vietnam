---
import { getCollection } from 'astro:content';
import Nhan from '../../components/Nhan.astro';
import The from '../../components/The.astro';
import Base from '../../layouts/Base.astro';
import { ngayVn, sapTheoNgayMoi } from '../../lib/bai-viet';
import { breadcrumbJsonLd } from '../../lib/seo';
import { TRANG } from '../../lib/trang';

// Chỉ bài đã được duyệt mới hiện. Bài đang soạn nằm trong repo nhưng không lên web và không
// lên sitemap, nên không có chuyện một bản nháp bị Google lập chỉ mục.
const bai = sapTheoNgayMoi(
  (await getCollection('baiViet', ({ data }) => data.daDuyet)).map((item) => ({
    slug: item.id,
    ...item.data,
  })),
);
const [dan, ...conLai] = bai;
---

<Base
  trang={TRANG.baiViet}
  jsonLd={[
    breadcrumbJsonLd([
      { ten: 'Trang chủ', path: TRANG.trangChu.path },
      { ten: 'Bài viết', path: TRANG.baiViet.path },
    ]),
  ]}
>
  <section class="mx-auto max-w-[1200px] px-4 pt-14 sm:px-6">
    <p class="mb-3"><Nhan chu="Bài viết" noiBat /></p>
    <h1 class="t-h1">{TRANG.baiViet.h1}</h1>
    <p class="t-lead mt-5 max-w-2xl text-muted">
      Ghi chép kỹ thuật về chi phí API bản đồ, dữ liệu mở và chất lượng geocode tại Việt Nam.
    </p>
  </section>

  <div class="mx-auto max-w-[1200px] px-4 pb-20 pt-12 sm:px-6">
    {
      dan === undefined ? (
        <p class="t-body rounded-[var(--radius-card)] border border-dashed border-border p-8 text-center text-muted">
          Chưa có bài nào được đăng. Bài đầu tiên đang trong quá trình biên tập.
        </p>
      ) : (
        <>
          {/* Bài mới nhất chiếm một khối lớn: người đọc lần đầu cần biết nên đọc gì trước, còn ba
              thẻ bằng nhau thì không nói được điều đó. */}
          <The as="article" data-testid="bai-dan" class="sm:p-8">
            <div class="grid items-center gap-8 lg:grid-cols-2">
              <div
                aria-hidden="true"
                class="hidden h-56 items-center rounded-[var(--radius-card)] bg-surface-2 p-6 lg:flex"
              >
                <p class="t-h3 text-muted">{dan.description}</p>
              </div>
              <div>
                <p class="t-mono-label">{ngayVn(dan.publishedAt).replaceAll('/', '.')}</p>
                <h2 class="t-h2 mt-3">
                  <a class="hover:underline" href={`/bai-viet/${dan.slug}/`}>
                    {dan.title}
                  </a>
                </h2>
                <p class="t-body mt-4 text-muted">{dan.description}</p>
                <ul class="mt-5 flex flex-wrap gap-2">
                  {dan.tags.map((tag) => (
                    <li class="t-small rounded-full border border-border px-3 py-1 text-muted">
                      {tag}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </The>

          {conLai.length > 0 && (
            <ul class="mt-4 divide-y divide-border border-y border-border">
              {conLai.map((b) => (
                <li data-testid="bai-hang">
                  <a
                    href={`/bai-viet/${b.slug}/`}
                    class="flex flex-wrap items-baseline justify-between gap-2 py-5 hover:text-accent-text"
                  >
                    <span class="t-h3">{b.title}</span>
                    <time class="t-mono-label" datetime={b.publishedAt}>
                      {ngayVn(b.publishedAt).replaceAll('/', '.')}
                    </time>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </>
      )
    }
  </div>
</Base>
