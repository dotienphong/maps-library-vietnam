---
import { COMPARISON } from '@mapslibvn/catalog';
import { CONSOLE_URL, DOCS_URL } from '../../../site.config.mjs';
import BangDoiDau from '../../components/BangDoiDau.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import Faq from '../../components/Faq.astro';
import Nhan from '../../components/Nhan.astro';
import Nut from '../../components/Nut.astro';
import The from '../../components/The.astro';
import Base from '../../layouts/Base.astro';
import { doiDauVietmap } from '../../lib/doi-dau';
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/seo';
import { TRANG } from '../../lib/trang';

const ngayVn = COMPARISON.checkedAt.split('-').reverse().join('/');

const KHI_NAO = [
  {
    chon: 'Chọn MapsLibVN khi',
    y: [
      'Bạn muốn hoá đơn cố định và dự toán được.',
      'Bạn muốn sản phẩm dựng trên dữ liệu mở OpenStreetMap và Foursquare OS.',
      'Nhu cầu nằm trong bản đồ, tìm kiếm, geocode và dẫn đường cơ bản.',
      'Bạn muốn bắt đầu ngay bằng bản dùng thử, không cần ký hợp đồng.',
    ],
  },
  {
    chon: 'Chọn VIETMAP khi',
    y: [
      'Bạn cần các lớp dữ liệu khảo sát riêng mà dữ liệu mở chưa phủ.',
      'Bài toán của bạn là theo dõi phương tiện, hoặc đội xe lớn hơn 5 xe / 30 đơn mỗi lượt.',
      'Lưu lượng thất thường và bạn muốn trả đúng theo số giao dịch phát sinh.',
      'Bạn cần một nhà cung cấp có hợp đồng và đội hỗ trợ doanh nghiệp lâu năm.',
    ],
  },
] as const;

const CAU_HOI = [
  {
    hoi: 'Hai bên có thay thế hoàn toàn cho nhau không?',
    dap: 'Không. Hai bên phủ phần lõi giống nhau là bản đồ, tìm kiếm và dẫn đường, nhưng VIETMAP có những lớp dữ liệu và bài toán vận tải mà MapsLibVN chưa làm. Nên so theo đúng nhu cầu của bạn thay vì so tổng thể.',
  },
  {
    hoi: 'Một request có bằng một transaction không?',
    dap: `Ở ba workload trong bảng thì bảng tính này quy ước một request bằng một transaction, và đó là một giả định. Cách tính thật có thể khác tuỳ endpoint, nên hãy kiểm lại bằng tài liệu của VIETMAP trước khi dựa vào con số.`,
  },
  {
    hoi: 'Vì sao nên tin bảng so sánh của chính người bán?',
    dap: `Đừng chỉ tin. Bảng lập ngày ${ngayVn}, mọi giả định và ba đường dẫn nguồn nằm ngay dưới bảng; cách dùng đúng là tính lại theo khối lượng thật của bạn rồi đối chiếu.`,
  },
] as const;
---

<Base
  trang={TRANG.soSanhVietmap}
  jsonLd={[
    faqJsonLd(CAU_HOI),
    breadcrumbJsonLd([
      { ten: 'Trang chủ', path: TRANG.trangChu.path },
      { ten: 'So với VIETMAP', path: TRANG.soSanhVietmap.path },
    ]),
  ]}
>
  <section class="mx-auto max-w-[1200px] px-4 pt-14 sm:px-6">
    <p class="mb-3"><Nhan chu="So sánh" noiBat /></p>
    <h1 class="t-h1 max-w-3xl">{TRANG.soSanhVietmap.h1}</h1>
    <p class="t-lead mt-5 max-w-2xl text-muted">
      Cả hai đều là nhà cung cấp bản đồ cho thị trường Việt Nam, nhưng khác nhau ở nguồn dữ liệu và
      cách tính tiền. Trang này so đúng phần chồng lấn, và nói rõ chỗ VIETMAP làm được mà
      MapsLibVN thì chưa.
    </p>
  </section>

  <section aria-labelledby="tt-doi-dau" class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6">
    <h2 id="tt-doi-dau" class="t-h2">Đối đầu từng tiêu chí</h2>
    <p class="t-body mt-3 max-w-2xl text-muted">
      Ô nào thắng thì tô màu nhấn, kể cả khi bên thắng là VIETMAP. Ba hàng chi phí đầu lấy thẳng từ
      bảng đối chiếu bên dưới, nơi có đủ giả định và nguồn.
    </p>
    <div class="mt-6">
      <BangDoiDau hang={doiDauVietmap()} tenHo="VIETMAP" />
    </div>
  </section>

  <section aria-labelledby="tt-chi-phi" class="border-y border-border bg-surface py-16">
    <h2 id="tt-chi-phi" class="t-h2 mx-auto mb-6 max-w-[1200px] px-4 sm:px-6">
      Chi phí: giả định và nguồn
    </h2>
    <ComparisonTable />
  </section>

  <section aria-labelledby="tt-khi-nao" class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6">
    <h2 id="tt-khi-nao" class="t-h2 mb-6">Khi nào nên chọn cái nào</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        KHI_NAO.map((cot) => (
          <The as="article" nen="surface-2">
            <h3 class="t-h3 mb-3">{cot.chon}</h3>
            <ul class="t-small list-disc space-y-2 pl-5 text-muted">
              {cot.y.map((y) => (
                <li>{y}</li>
              ))}
            </ul>
          </The>
        ))
      }
    </div>
    <p class="t-body mt-6 text-muted">
      Cách quyết định đáng tin nhất là lấy một bộ địa chỉ và tuyến đường thật của bạn rồi chạy thử
      trên cả hai.
      <a class="text-accent-text underline" href={`${DOCS_URL}/do-chinh-xac/`}>Cách đo độ chính xác geocode →</a>
    </p>
  </section>

  <Faq items={CAU_HOI} tieuDe="Câu hỏi thường gặp khi so sánh" />

  <section class="mx-auto max-w-3xl px-4 pb-20 text-center">
    <Nut href={CONSOLE_URL} co="lon">Thử bằng bản miễn phí</Nut>
  </section>
</Base>
