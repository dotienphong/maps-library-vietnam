---
import { COMPARISON } from '@mapslibvn/catalog';
import { CONSOLE_URL, DOCS_URL } from '../../../site.config.mjs';
import ComparisonTable from '../../components/ComparisonTable.astro';
import Faq from '../../components/Faq.astro';
import Base from '../../layouts/Base.astro';
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/seo';
import { TRANG } from '../../lib/trang';

const ngayVn = COMPARISON.checkedAt.split('-').reverse().join('/');

const KHAC_BIET = [
  {
    tieuDe: 'Cách tính tiền',
    mapslibvn:
      'Gói cố định theo kỳ. Bạn biết trước hoá đơn tháng này là bao nhiêu, hết hạn mức thì API báo lỗi có cấu trúc chứ không âm thầm phát sinh thêm tiền.',
    vietmap:
      'Tính theo transaction. Linh hoạt khi lưu lượng thất thường, nhưng hoá đơn phụ thuộc mức dùng thật nên khó dự toán trước.',
  },
  {
    tieuDe: 'Nguồn dữ liệu',
    mapslibvn:
      'Dữ liệu mở OpenStreetMap và Foursquare OS. Bạn dựng lại được toàn bộ hệ thống trên hạ tầng của mình, và biết chính xác dữ liệu đến từ đâu.',
    vietmap:
      'Dữ liệu bản đồ riêng do doanh nghiệp tự khảo sát và duy trì nhiều năm, gồm cả những lớp mà dữ liệu mở chưa có.',
  },
  {
    tieuDe: 'Phạm vi sản phẩm',
    mapslibvn:
      'Bản đồ nền, địa điểm, tìm kiếm, geocode và dẫn đường cơ bản, kèm bốn SDK. Chưa có ma trận khoảng cách và tối ưu đội xe.',
    vietmap:
      'Hệ sản phẩm rộng hơn, có các bài toán vận tải và theo dõi phương tiện mà MapsLibVN chưa làm.',
  },
  {
    tieuDe: 'Khả năng tự host',
    mapslibvn:
      'Toàn bộ pipeline và SDK là mã mở, tự dựng được. Đây là lối thoát nếu một ngày bạn muốn rời khỏi dịch vụ.',
    vietmap: 'Dịch vụ đám mây theo hợp đồng; tự host không phải mô hình của họ.',
  },
] as const;

const KHI_NAO = [
  {
    chon: 'Chọn MapsLibVN khi',
    y: [
      'Bạn muốn hoá đơn cố định và dự toán được.',
      'Bạn coi trọng việc dữ liệu là mở và có thể tự dựng lại.',
      'Nhu cầu nằm trong bản đồ, tìm kiếm, geocode và dẫn đường cơ bản.',
      'Bạn muốn bắt đầu ngay bằng bản dùng thử, không cần ký hợp đồng.',
    ],
  },
  {
    chon: 'Chọn VIETMAP khi',
    y: [
      'Bạn cần các lớp dữ liệu khảo sát riêng mà dữ liệu mở chưa phủ.',
      'Bài toán của bạn là vận tải, theo dõi phương tiện hoặc tối ưu lộ trình đội xe.',
      'Lưu lượng thất thường và bạn muốn trả đúng theo số giao dịch phát sinh.',
      'Bạn cần một nhà cung cấp có hợp đồng và đội hỗ trợ doanh nghiệp lâu năm.',
    ],
  },
] as const;

const CAU_HOI = [
  {
    hoi: 'Hai bên có thay thế hoàn toàn cho nhau không?',
    dap: 'Không. Hai bên phủ phần lõi giống nhau là bản đồ, tìm kiếm và dẫn đường, nhưng VIETMAP có những lớp dữ liệu và bài toán vận tải mà MapsLibVN chưa làm. Nên so theo đúng nhu cầu của bạn thay vì so tổng thể.',
  },
  {
    hoi: 'Một request có bằng một transaction không?',
    dap: `Ở ba workload trong bảng thì bảng tính này quy ước một request bằng một transaction, và đó là một giả định. Cách tính thật có thể khác tuỳ endpoint, nên hãy kiểm lại bằng tài liệu của VIETMAP trước khi dựa vào con số.`,
  },
  {
    hoi: 'Vì sao nên tin bảng so sánh của chính người bán?',
    dap: `Đừng chỉ tin. Bảng lập ngày ${ngayVn}, mọi giả định và ba đường dẫn nguồn nằm ngay dưới bảng; cách dùng đúng là tính lại theo khối lượng thật của bạn rồi đối chiếu.`,
  },
] as const;
---

<Base
  trang={TRANG.soSanhVietmap}
  jsonLd={[
    faqJsonLd(CAU_HOI),
    breadcrumbJsonLd([
      { ten: 'Trang chủ', path: TRANG.trangChu.path },
      { ten: 'So với VIETMAP', path: TRANG.soSanhVietmap.path },
    ]),
  ]}
>
  <section class="mx-auto max-w-3xl px-4 pt-12">
    <h1 class="text-3xl font-bold sm:text-4xl">{TRANG.soSanhVietmap.h1}</h1>
    <p class="mt-4 text-lg text-[var(--text-muted)]">
      Cả hai đều là nhà cung cấp bản đồ cho thị trường Việt Nam, nhưng khác nhau ở nguồn dữ liệu và
      cách tính tiền. Trang này so đúng phần chồng lấn, và nói rõ chỗ VIETMAP làm được mà
      MapsLibVN thì chưa.
    </p>
  </section>

  <section aria-labelledby="tt-chi-phi" class="py-12">
    <h2 id="tt-chi-phi" class="mx-auto mb-6 max-w-6xl px-4 text-2xl font-bold">Chi phí</h2>
    <ComparisonTable />
  </section>

  <section aria-labelledby="tt-khac-biet" class="bg-[var(--surface)] py-16">
    <div class="mx-auto max-w-4xl px-4">
      <h2 id="tt-khac-biet" class="mb-6 text-2xl font-bold">Bốn khác biệt đáng kể</h2>
      <div class="space-y-6">
        {
          KHAC_BIET.map((kb) => (
            <article class="rounded-[var(--radius-card)] border border-[var(--border)] bg-[var(--bg)] p-5">
              <h3 class="mb-3 font-bold">{kb.tieuDe}</h3>
              <dl class="grid gap-4 sm:grid-cols-2">
                <div>
                  <dt class="text-sm font-semibold text-accent-text">
                    MapsLibVN
                  </dt>
                  <dd class="mt-1 text-[var(--text-muted)]">{kb.mapslibvn}</dd>
                </div>
                <div>
                  <dt class="text-sm font-semibold">VIETMAP</dt>
                  <dd class="mt-1 text-[var(--text-muted)]">{kb.vietmap}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="tt-khi-nao" class="mx-auto max-w-4xl px-4 py-16">
    <h2 id="tt-khi-nao" class="mb-6 text-2xl font-bold">Khi nào nên chọn cái nào</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        KHI_NAO.map((cot) => (
          <article class="rounded-[var(--radius-card)] border border-[var(--border)] bg-[var(--surface)] p-5">
            <h3 class="mb-3 font-bold">{cot.chon}</h3>
            <ul class="list-disc space-y-2 pl-5 text-[var(--text-muted)]">
              {cot.y.map((y) => (
                <li>{y}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <p class="mt-6 text-[var(--text-muted)]">
      Cách quyết định đáng tin nhất là lấy một bộ địa chỉ và tuyến đường thật của bạn rồi chạy thử
      trên cả hai.
      <a class="underline" href={`${DOCS_URL}/do-chinh-xac/`}>Cách đo độ chính xác geocode →</a>
    </p>
  </section>

  <Faq items={CAU_HOI} tieuDe="Câu hỏi thường gặp khi so sánh" />

  <section class="mx-auto max-w-3xl px-4 pb-20 text-center">
    <a
      href={CONSOLE_URL}
      class="inline-flex min-h-11 items-center rounded-[var(--radius-btn)] bg-accent px-6 font-semibold text-accent-ink hover:brightness-95"
    >
      Thử bằng bản miễn phí
    </a>
  </section>
</Base>
