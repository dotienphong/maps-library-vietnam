---
import { COMPARISON } from '@mapslibvn/catalog';
import { CONSOLE_URL, DOCS_URL } from '../../../site.config.mjs';
import BangDoiDau from '../../components/BangDoiDau.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import Faq from '../../components/Faq.astro';
import Nhan from '../../components/Nhan.astro';
import Nut from '../../components/Nut.astro';
import The from '../../components/The.astro';
import Base from '../../layouts/Base.astro';
import { doiDauGoogle } from '../../lib/doi-dau';
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/seo';
import { TRANG } from '../../lib/trang';

const ngayVn = COMPARISON.checkedAt.split('-').reverse().join('/');

const KHI_NAO = [
  {
    chon: 'Chọn MapsLibVN khi',
    y: [
      'Người dùng của bạn ở Việt Nam.',
      'Chi phí Google đang là khoản đáng kể trong hoá đơn hạ tầng.',
      'Bạn cần tìm kiếm và geocode hiểu cách người Việt gõ địa chỉ.',
      'Bạn muốn giữ khả năng tự host về sau.',
      'Bạn cần ma trận khoảng cách hoặc sắp thứ tự giao cho từng chuyến mà không muốn trả tiền theo từng cặp điểm.',
      'Bạn cần thanh toán bằng VND trong nước.',
    ],
  },
  {
    chon: 'Ở lại với Google khi',
    y: [
      'Bạn phục vụ người dùng nhiều quốc gia.',
      'Sản phẩm dựa vào Street View, ảnh vệ tinh hoặc giao thông thời gian thực.',
      'Bạn cần đánh giá và giờ mở cửa của hàng quán ở mức chi tiết cao.',
      'Bạn cần chia đơn cho cả đội xe cùng lúc, có sức chứa và khung giờ giao.',
      'Bạn cần cam kết mức dịch vụ bằng hợp đồng.',
      'Chi phí hiện tại còn nằm trong hạn mức miễn phí của Google.',
    ],
  },
] as const;

const CAU_HOI = [
  {
    hoi: 'Chuyển từ Google sang mất bao nhiêu công?',
    dap: 'Phần bản đồ và tìm kiếm thường chỉ là thay SDK và đổi cách đọc kết quả, vì cả hai bên đều trả JSON có toạ độ và tên. Phần tốn công nhất là chỗ nào đang lưu place_id của Google: mã đó không dùng lại được, bạn phải tra lại theo tên và toạ độ.',
  },
  {
    hoi: 'Dùng song song hai nhà cung cấp được không?',
    dap: 'Được, và nhiều đội làm vậy thật: dùng MapsLibVN cho phần lớn lưu lượng trong nước, giữ Google cho các tính năng chỉ Google có. Điều khoản của MapsLibVN không cấm điều này.',
  },
  {
    hoi: 'Có tính được khoảng cách và thứ tự giao hàng cho đội xe không?',
    dap: 'Có, cho từng xe. Ma trận khoảng cách trả thời gian và quãng đường tới 50 cặp điểm mỗi lượt để chọn tài xế hay kho gần nhất; tối ưu thứ tự sắp lại tối đa 10 điểm dừng cho một chuyến và trả luôn tuyến để dẫn đường. Mỗi lượt gọi tính một lượt Chỉ đường bất kể bao nhiêu cặp. Chưa có bộ giải chia đơn cho nhiều xe cùng lúc như Route Optimization API của Google.',
  },
  {
    hoi: 'Số trong bảng này có được kiểm chứng độc lập không?',
    dap: `Không. Đây là bảng do chính MapsLibVN lập ngày ${ngayVn} dựa trên bảng giá công bố của các bên, kèm toàn bộ giả định và ba đường dẫn nguồn ngay dưới bảng để bạn tự tính lại theo khối lượng thật của mình.`,
  },
] as const;
---

<Base
  trang={TRANG.soSanhGoogle}
  jsonLd={[
    faqJsonLd(CAU_HOI),
    breadcrumbJsonLd([
      { ten: 'Trang chủ', path: TRANG.trangChu.path },
      { ten: 'So với Google', path: TRANG.soSanhGoogle.path },
    ]),
  ]}
>
  <section class="mx-auto max-w-[1200px] px-4 pt-14 sm:px-6">
    <p class="mb-3"><Nhan chu="So sánh" noiBat /></p>
    <h1 class="t-h1 max-w-3xl">{TRANG.soSanhGoogle.h1}</h1>
    <p class="t-lead mt-5 max-w-2xl text-muted">
      Đây là bản so sánh do chính nhà cung cấp MapsLibVN viết, nên bạn có quyền nghi ngờ. Vì vậy
      mọi con số đều kèm ngày đối chiếu {ngayVn}, giả định cụ thể và đường dẫn nguồn để bạn tính
      lại theo khối lượng thật của mình. Trang này cũng nói rõ những chỗ Google hơn hẳn.
    </p>
  </section>

  <section aria-labelledby="tt-doi-dau" class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6">
    <h2 id="tt-doi-dau" class="t-h2">Đối đầu từng tiêu chí</h2>
    <p class="t-body mt-3 max-w-2xl text-muted">
      Ô nào thắng thì tô màu nhấn, kể cả khi bên thắng là Google. Ba hàng chi phí đầu lấy thẳng từ
      bảng đối chiếu bên dưới, nơi có đủ giả định và nguồn.
    </p>
    <div class="mt-6">
      <BangDoiDau hang={doiDauGoogle()} tenHo="Google" />
    </div>
  </section>

  <section aria-labelledby="tt-chi-phi" class="border-y border-border bg-surface py-16">
    <h2 id="tt-chi-phi" class="t-h2 mx-auto mb-6 max-w-[1200px] px-4 sm:px-6">
      Chi phí: giả định và nguồn
    </h2>
    <ComparisonTable />
  </section>

  <section aria-labelledby="tt-doi-xe" class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h2 id="tt-doi-xe" class="t-h2 mb-4">Giao hàng và đội xe</h2>
    <p class="t-body mb-3 text-muted">
      Google tính tiền ma trận khoảng cách theo từng phần tử: một bảng 7 tài xế × 7 đơn là 49 phần
      tử trên hoá đơn. MapsLibVN tính cả bảng đó là <strong class="text-text">một lượt</strong>
      Chỉ đường, và tối ưu thứ tự cho một chuyến cũng một lượt, kèm luôn tuyến đầy đủ để vẽ và dẫn
      đường bằng câu tiếng Việt.
    </p>
    <p class="t-body mb-3 text-muted">
      Đổi lại, cỡ mỗi lượt nhỏ hơn: tối đa 50 cặp (mỗi bên 25 điểm) hoặc 10 điểm dừng, 6 lượt mỗi
      phút. Bảng lớn hơn thì chia lô; chia đơn cho nhiều xe có sức chứa và khung giờ thì Google vẫn
      là lựa chọn đúng.
    </p>
    <p class="t-body text-muted">
      <a class="text-accent-text underline" href={`${DOCS_URL}/doi-xe/`}>Hướng dẫn giao hàng &amp; đội xe →</a>
      <span class="mx-2" aria-hidden="true">·</span>
      <a class="text-accent-text underline" href={`${DOCS_URL}/playground#doi-xe`}>Thử trên Playground →</a>
    </p>
  </section>

  <section aria-labelledby="tt-khi-nao" class="border-y border-border bg-surface py-16">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
      <h2 id="tt-khi-nao" class="t-h2 mb-6">Khi nào nên chọn cái nào</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          KHI_NAO.map((cot) => (
            <The as="article" nen="surface-2">
              <h3 class="t-h3 mb-3">{cot.chon}</h3>
              <ul class="t-small list-disc space-y-2 pl-5 text-muted">
                {cot.y.map((y) => (
                  <li>{y}</li>
                ))}
              </ul>
            </The>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="tt-chuyen" class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h2 id="tt-chuyen" class="t-h2 mb-4">Chuyển sang thì mất gì</h2>
    <p class="t-body mb-3 text-muted">
      Thay thư viện bản đồ và đổi cách đọc kết quả tìm kiếm là phần dễ. Ba chỗ hay tốn thời gian:
      dữ liệu đang lưu mã địa điểm của Google phải tra lại theo tên và toạ độ; giao diện nào đang
      dựa vào Street View phải thiết kế lại; và bộ kiểm thử tự động cần cập nhật vì hình dạng phản
      hồi khác nhau.
    </p>
    <p class="t-body text-muted">
      Cách ít rủi ro nhất là chạy song song: đưa một phần lưu lượng sang MapsLibVN bằng bản dùng
      thử, so kết quả trên chính bộ địa chỉ của bạn, rồi mới quyết định.
      <a class="text-accent-text underline" href={`${DOCS_URL}/bat-dau/`}>Hướng dẫn bắt đầu →</a>
    </p>
  </section>

  <Faq items={CAU_HOI} tieuDe="Câu hỏi thường gặp khi so sánh" />

  <section class="mx-auto max-w-3xl px-4 pb-20 text-center">
    <Nut href={CONSOLE_URL} co="lon">Thử bằng bản miễn phí</Nut>
  </section>
</Base>
