---
import {
  CONSOLE_URL,
  DOCS_URL,
  SUPPORT_EMAIL,
  SUPPORT_PHONE,
  SUPPORT_PHONE_HIEN_THI,
} from '../../site.config.mjs';
import Nhan from '../components/Nhan.astro';
import The from '../components/The.astro';
import Base from '../layouts/Base.astro';
import { breadcrumbJsonLd } from '../lib/seo';
import { TRANG } from '../lib/trang';

const GIO = [
  ['Thứ Hai đến thứ Sáu', '08:00 – 20:00'],
  ['Thứ Bảy và Chủ nhật', '08:00 – 17:00'],
] as const;

const NHANH = [
  {
    nhan: 'Tài liệu kỹ thuật',
    mo: 'REST API, SDK, hướng dẫn bắt đầu 5 phút.',
    href: `${DOCS_URL}/bat-dau/`,
  },
  {
    nhan: 'Thử trực tiếp',
    mo: 'Trang playground, không cần đăng ký.',
    href: `${DOCS_URL}/playground`,
  },
  { nhan: 'Cổng khách hàng', mo: 'Tự lấy khoá API, xem mức dùng, mua gói.', href: CONSOLE_URL },
] as const;
---

<Base
  trang={TRANG.lienHe}
  jsonLd={[
    breadcrumbJsonLd([
      { ten: 'Trang chủ', path: TRANG.trangChu.path },
      { ten: 'Liên hệ', path: TRANG.lienHe.path },
    ]),
  ]}
>
  <section class="mx-auto max-w-[1200px] px-4 pt-14 sm:px-6">
    <p class="mb-3"><Nhan chu="Liên hệ" noiBat /></p>
    <h1 class="t-h1">{TRANG.lienHe.h1}</h1>
    <p class="t-lead mt-5 max-w-2xl text-muted">
      Gọi điện hoặc viết thư đều được. Hiện chưa có hộp thoại trò chuyện trực tiếp trên website.
    </p>
  </section>

  <div class="mx-auto grid max-w-[1200px] gap-8 px-4 py-12 sm:px-6 lg:grid-cols-2">
    <div class="space-y-4">
      {/* Gọi điện là đường nhanh nhất nên nó là thứ duy nhất được viền nhấn trên trang này. */}
      <The noiBat data-testid="the-goi">
        {/* Thẻ tiêu đề THẬT chứ không phải span: trình đọc màn hình đi theo danh sách tiêu đề
            để nhảy giữa các khối, và bài e2e cũ đã bắt được đúng chỗ này. */}
        <h2><Nhan chu="Điện thoại" /></h2>
        <p class="mt-2">
          {/* href dạng E.164 không khoảng trắng; chạm trên điện thoại là gọi ngay. */}
          <a
            href={`tel:${SUPPORT_PHONE}`}
            class="t-h2 inline-flex min-h-11 items-center text-accent-text hover:underline"
          >
            {SUPPORT_PHONE_HIEN_THI}
          </a>
        </p>
        <p class="t-small mt-2 text-muted">
          Gọi trong giờ hỗ trợ bên cạnh. Ngoài giờ, hãy để lại thư và bạn sẽ được trả lời vào buổi
          làm việc kế tiếp.
        </p>
      </The>

      <The data-testid="the-thu">
        <h2><Nhan chu="Thư điện tử" /></h2>
        <p class="mt-2">
          <a
            href={`mailto:${SUPPORT_EMAIL}`}
            class="t-h3 inline-flex min-h-11 items-center break-all hover:underline"
          >
            {SUPPORT_EMAIL}
          </a>
        </p>
        <p class="t-small mt-2 text-muted">
          Ghi rõ tên tổ chức và tiền tố khoá API nếu bạn đang là khách hàng, thư sẽ được xử lý nhanh
          hơn. Đừng gửi khoá API đầy đủ qua thư.
        </p>
      </The>
    </div>

    <div class="space-y-8">
      <section aria-labelledby="tt-gio">
        <h2 id="tt-gio" class="t-h2">Giờ hỗ trợ trực tuyến</h2>
        <p class="t-body mt-3 text-muted">
          Áp dụng cho gói Professional và Business, theo giờ Việt Nam. Gói Starter và bản dùng thử
          được hỗ trợ qua tài liệu.
        </p>
        <table
          class="mt-5 w-full border-collapse overflow-hidden rounded-[var(--radius-card)] border border-border"
        >
          <tbody>
            {
              GIO.map(([ngay, gio]) => (
                <tr class="border-b border-border last:border-0">
                  <th scope="row" class="t-small px-4 py-3 text-left font-normal text-muted">
                    {ngay}
                  </th>
                  <td class="t-small px-4 py-3 text-right font-semibold">{gio}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <section aria-labelledby="tt-nhanh">
        <h2 id="tt-nhanh" class="t-h2">Có thể bạn cần ngay</h2>
        <ul class="mt-5 divide-y divide-border border-y border-border">
          {
            NHANH.map((n) => (
              <li>
                <a href={n.href} class="block py-4 hover:text-accent-text">
                  <span class="t-h3">{n.nhan} →</span>
                  <span class="t-small mt-1 block text-muted">{n.mo}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Base>
