---
import { PLAN_CATALOG } from '@mapslibvn/catalog';
import { DOCS_URL } from '../../site.config.mjs';
import ComparisonTable from '../components/ComparisonTable.astro';
import Faq from '../components/Faq.astro';
import Nhan from '../components/Nhan.astro';
import PricingCards from '../components/PricingCards.astro';
import ThanhUocTinh from '../components/ThanhUocTinh.astro';
import The from '../components/The.astro';
import Base from '../layouts/Base.astro';
import { bangGia, dinhDangSo, dinhDangVnd } from '../lib/gia';
import { breadcrumbJsonLd, faqJsonLd, softwareApplicationJsonLd } from '../lib/seo';
import { TRANG } from '../lib/trang';

const MUA_THEM = [
  {
    ten: 'Lượt Places',
    khoi: dinhDangSo(PLAN_CATALOG.addOns.places.units),
    gia: dinhDangVnd(PLAN_CATALOG.addOns.places.priceVnd),
  },
  {
    ten: 'Lượt tính tuyến',
    khoi: dinhDangSo(PLAN_CATALOG.addOns.directions.units),
    gia: dinhDangVnd(PLAN_CATALOG.addOns.directions.priceVnd),
  },
];

/** Bảng đối chiếu hạn mức: mỗi hàng một tiêu chí, mỗi cột một gói. Dữ liệu từ bangGia(). */
const GOI = bangGia();
const HANG_HAN_MUC = [
  [
    'Giá mỗi tháng',
    ...GOI.map((g) => `${g.theoKy[1].vndHienThi}${g.tier === 'trial' ? ' / 30 ngày' : ''}`),
  ],
  ['Lượt Places mỗi kỳ', ...GOI.map((g) => g.placesHienThi)],
  ['Lượt tính tuyến mỗi kỳ', ...GOI.map((g) => g.directionsHienThi)],
  ['Trần theo ngày', ...GOI.map((g) => g.tranNgay ?? 'Không có')],
  ['Hạn mức làm mới', ...GOI.map((g) => g.ghiChuHan)],
  ['Hỗ trợ trực tuyến', ...GOI.map((g) => (g.hoTroOnline ? 'Có' : 'Qua tài liệu'))],
  ['Mua thêm lượt', ...GOI.map((g) => (g.tier === 'trial' ? 'Không' : 'Theo khối 1.000'))],
  ['Kỳ mua được', ...GOI.map((g) => (g.tier === 'trial' ? '30 ngày' : '1, 3, 6, 12 tháng'))],
] as const;

const CAU_HOI = [
  {
    hoi: 'Có hoá đơn VAT không?',
    dap: 'Giai đoạn này hệ thống chỉ phát hành biên nhận thanh toán, chưa có hoá đơn điện tử VAT. Nếu bạn cần hoá đơn để hạch toán, hãy liên hệ trước khi mua để được hướng dẫn.',
  },
  {
    hoi: 'Đang dùng dở một gói mà muốn đổi sang gói khác thì sao?',
    dap: 'Kỳ mới bắt đầu ngay sau kỳ hiện tại kết thúc, hệ thống không tính chênh lệch giữa kỳ. Nếu bạn cần đổi có hiệu lực ngay, hãy liên hệ để được xử lý thủ công.',
  },
  {
    hoi: 'Có hoàn tiền không?',
    dap: 'Việc hoàn tiền được xử lý ngoài hệ thống theo từng trường hợp, không có nút tự hoàn. Đó là lý do nên bắt đầu bằng bản dùng thử để đo mức dùng thật trước khi trả tiền.',
  },
  {
    hoi: 'Hạn mức tính chung hay tính riêng từng khoá?',
    dap: 'Tính chung theo thuê bao. Mọi khoá API của cùng một tổ chức trừ vào cùng một hạn mức, nên cấp thêm khoá không làm tăng số lượt bạn được dùng.',
  },
  {
    hoi: 'Lượt xem bản đồ và băng thông tiles tính thế nào?',
    dap: 'Hiện nằm trong gói và chưa có trần công bố. Chúng tôi chưa hứa vô hạn: khi đo được khối lượng thật sẽ công bố hạn mức rõ ràng trước khi áp dụng.',
  },
  {
    hoi: 'Lượt mua thêm sống được bao lâu?',
    dap: 'Lượt mua thêm hết hạn cùng lúc với kỳ thuê bao đang chạy, và chỉ mua được khi gói trả phí đang hoạt động. Lượt chưa dùng không chuyển sang kỳ sau.',
  },
] as const;
---

<Base
  trang={TRANG.bangGia}
  jsonLd={[
    softwareApplicationJsonLd(),
    faqJsonLd(CAU_HOI),
    breadcrumbJsonLd([
      { ten: 'Trang chủ', path: TRANG.trangChu.path },
      { ten: 'Bảng giá', path: TRANG.bangGia.path },
    ]),
  ]}
>
  <section class="mx-auto max-w-[1200px] px-4 pt-14 sm:px-6">
    <p class="mb-3"><Nhan chu="Bảng giá" noiBat /></p>
    <h1 class="t-h1">{TRANG.bangGia.h1}</h1>
    <p class="t-lead mt-5 max-w-2xl text-muted">
      Giá tính theo số lượt gọi API mỗi kỳ, không theo số người dùng cuối và không theo số lần mở
      ứng dụng. Thu bằng VND qua PayOS, chuyển khoản hoặc quét mã VietQR bằng ứng dụng ngân hàng; số
      USD chỉ là con số tham chiếu.
    </p>
    <div class="mt-8">
      <ThanhUocTinh />
    </div>
  </section>

  <div class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6">
    <PricingCards />
  </div>

  <section aria-labelledby="tt-han-muc" class="mx-auto max-w-[1200px] px-4 pb-4 sm:px-6">
    <h2 id="tt-han-muc" class="t-h2">Đối chiếu hạn mức</h2>
    <div class="mt-6 overflow-x-auto rounded-[var(--radius-card)] border border-border">
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">Bảng đối chiếu hạn mức bốn gói</caption>
        <thead>
          <tr class="bg-surface-2">
            <th scope="col" class="t-small px-4 py-3 font-semibold">Tiêu chí</th>
            {
              GOI.map((g) => (
                <th
                  scope="col"
                  class:list={[
                    't-small px-4 py-3 font-semibold',
                    g.noiBat && 'text-accent-text',
                  ]}
                >
                  {g.ten}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            HANG_HAN_MUC.map(([tieuChi, ...o]) => (
              <tr class="border-t border-border align-top">
                <th scope="row" class="t-small px-4 py-3 font-normal text-muted">
                  {tieuChi}
                </th>
                {o.map((v, i) => (
                  <td class:list={['t-small px-4 py-3', GOI[i]?.noiBat && 'bg-accent-soft']}>{v}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="tt-mua-them" class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6">
    <h2 id="tt-mua-them" class="t-h2 mb-2">Mua thêm lượt</h2>
    <p class="t-body mb-6 text-muted">
      Dùng hết hạn mức giữa kỳ thì mua thêm theo khối, không phải nâng cả gói.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        MUA_THEM.map((m) => (
          <The as="article">
            <h3 class="t-h3">{m.ten}</h3>
            <p class="mt-2">
              <span class="t-stat">{m.gia}</span>
              <span class="t-small text-muted"> / {m.khoi} lượt</span>
            </p>
          </The>
        ))
      }
    </div>
    <p class="t-small mt-4 text-muted">
      Lượt mua thêm hết hạn cùng kỳ thuê bao đang chạy và chỉ mua được khi gói trả phí đang hoạt
      động.
    </p>
  </section>

  <section
    aria-labelledby="tt-so-sanh"
    id="so-sanh"
    class="scroll-mt-24 border-y border-border bg-surface py-16"
  >
    <h2 id="tt-so-sanh" class="t-h2 mx-auto mb-2 max-w-[1200px] px-4 sm:px-6">
      So với Google và VIETMAP
    </h2>
    <p class="t-body mx-auto mb-8 max-w-[1200px] px-4 text-muted sm:px-6">
      Ba mức dùng thật, cùng một khối lượng gọi API, quy đổi về VND. Giả định và nguồn nằm ngay
      dưới bảng để bạn tự kiểm lại.
    </p>
    <ComparisonTable />
  </section>

  <Faq items={CAU_HOI} tieuDe="Câu hỏi về giá" />

  <section class="t-small mx-auto max-w-3xl px-4 pb-20 text-center text-muted">
    <p>
      Mua gói tức là bạn đồng ý với
      <a class="text-accent-text underline" href={`${DOCS_URL}/dieu-khoan/`}>điều khoản tenant</a>, trong đó có nghĩa
      vụ giữ phần ghi nguồn dữ liệu mở.
    </p>
  </section>
</Base>
