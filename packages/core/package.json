{
  "name": "@mapslibvn/core",
  "version": "0.15.1",
  "description": "Client TypeScript cho API bản đồ Việt Nam MapsLibVN: autocomplete, tìm kiếm địa điểm, geocode, dẫn đường, ma trận khoảng cách và chuỗi ghi nguồn (Vietnam maps API client)",
  "keywords": [
    "mapslibvn",
    "vietnam",
    "viet-nam",
    "vietnam-map",
    "ban-do",
    "bản đồ",
    "map",
    "maps",
    "geocoding",
    "autocomplete",
    "places",
    "poi",
    "directions",
    "routing",
    "openstreetmap",
    "api-client",
    "typescript",
    "reverse-geocoding",
    "distance-matrix"
  ],
  "homepage": "https://mapslibvn.pages.dev/",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "//build": "--minify từ 17/09/2026: size-limit đo FILE THÔ nên comment giải thích trong mã cũng tính vào ngân sách, và barrel đã chạm trần 20 kB. Có --sourcemap kèm theo để vẫn dò được lỗi trong node_modules.",
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022 --minify --sourcemap && size-limit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@size-limit/file": "^14.0.0",
    "@types/node": "^26",
    "size-limit": "^14.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
