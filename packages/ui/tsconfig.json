{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "node" cho tokens.test.ts: nó đọc CHÍNH tokens.css bằng node:fs để tính tương phản, thay vì
