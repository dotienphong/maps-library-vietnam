{
  "name": "@mapslibvn/react-native",
  "version": "0.14.2",
  "description": "React Native bindings MapsLibVN: <MapsLibVNMap>, <Marker>, useMap, usePlaces, dẫn đường (createNavigationSession, useNavigation; entry /expo cho định vị nền + TTS), la bàn + con quay hồi chuyển (useHeading, userLocation) — bọc @maplibre/maplibre-react-native",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./expo": {
      "types": "./dist/expo/index.d.ts",
      "import": "./dist/expo/index.js",
      "default": "./dist/expo/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && ls dist/chunk-*.js >/dev/null 2>&1 || (echo 'CHẶN: dist/chunk-*.js không còn tồn tại — size-limit sẽ đo thiếu, cập nhật .size-limit.json nếu tsup đổi cách tách chunk' >&2 && exit 1) && size-limit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@maplibre/maplibre-react-native": "^11.3.0",
    "expo-audio": ">=1.0.10",
    "expo-keep-awake": ">=15.0.6",
    "expo-location": ">=19.0.6",
    "expo-sensors": ">=15.0.0",
    "expo-speech": ">=14.0.6",
    "expo-task-manager": ">=14.0.6",
    "react": ">=19.1.0",
    "react-native": ">=0.80.0"
  },
  "peerDependenciesMeta": {
    "expo-audio": {
      "optional": true
    },
    "expo-keep-awake": {
      "optional": true
    },
    "expo-location": {
      "optional": true
    },
    "expo-sensors": {
      "optional": true
    },
    "expo-speech": {
      "optional": true
    },
    "expo-task-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@maplibre/maplibre-react-native": "^11.3.10",
    "@mapslibvn/core": "workspace:*",
    "@size-limit/file": "^14.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.87.1",
    "size-limit": "^14.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
