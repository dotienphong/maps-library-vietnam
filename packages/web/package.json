{
  "name": "@mapslibvn/web",
  "version": "0.14.2",
  "description": "SDK web MapsLibVN: bọc maplibre-gl, pmtiles, attribution bắt buộc",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./umd": "./dist/mapslibvn.umd.js",
    "./style.css": "./dist/mapslibvn.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022 --external maplibre-gl --external pmtiles && vite build -c vite.umd.config.ts && size-limit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.4.1"
  },
  "dependencies": {
    "@mapslibvn/core": "workspace:*",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@size-limit/file": "^14.0.0",
    "@types/node": "^26",
    "maplibre-gl": "^6.9.1",
    "size-limit": "^14.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
