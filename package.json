{
  "name": "mapslibvn",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "deploy:api": "pnpm build && pnpm --filter @mapslibvn/api exec wrangler deploy --env production",
    "deploy:docs": "pnpm build && pnpm --filter @mapslibvn/docs exec wrangler pages deploy dist --project-name mapslibvn-docs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "notices:sync": "node scripts/notices-sync.mjs",
    "typecheck": "pnpm --filter @mapslibvn/core build && tsc -p tsconfig.scripts.json && turbo run typecheck --continue",
    "test": "pnpm --filter @mapslibvn/core build && vitest run && pnpm --filter @mapslibvn/admin build && pnpm --filter @mapslibvn/api test",
    "test:watch": "vitest",
    "db:up": "docker compose --env-file .env -f infra/dev/compose.yml up -d postgres",
    "db:down": "docker compose --env-file .env -f infra/dev/compose.yml down",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed-tenant": "node scripts/db-seed-tenant.mjs",
    "key:issue": "node scripts/api-key-issue.mjs",
    "example:embed": "node scripts/example-embed.mjs",
    "example:rn": "node scripts/example-rn.mjs",
    "image:build": "node scripts/image.mjs build",
    "image:smoke": "node scripts/image.mjs smoke",
    "sdk:publish": "node scripts/npm-sdk-publish.mjs",
    "data:update": "node scripts/data-update.mjs",
    "data:rollback": "node scripts/data-rollback.mjs",
    "export:odbl": "node scripts/export-odbl.mjs",
    "report:weekly": "node scripts/weekly-report.mjs",
    "load:api": "node scripts/load-api.mjs",
    "smoke:rate-limit": "node scripts/smoke-rate-limit.mjs",
    "smoke:directions": "node scripts/smoke-directions.mjs",
    "check:git": "node scripts/check-git-identity.mjs",
    "test:db": "node scripts/db-test.mjs",
    "test:api-db": "node scripts/api-db-test.mjs",
    "test:routing": "node scripts/routing-test.mjs",
    "test:admin-e2e": "pnpm --filter @mapslibvn/admin test:e2e",
    "server:setup": "node scripts/server-setup.mjs",
    "server:restore": "node scripts/server-restore.mjs",
    "server:update": "node scripts/server-update.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:fixture": "node scripts/db-fixture.mjs",
    "poi:profile": "node scripts/poi-profile-publish.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@testing-library/react": "^16.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-spawn": "^7.0.6",
    "dotenv": "^16.4.5",
    "jsdom": "^25.0.0",
    "postgres": "^3.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
